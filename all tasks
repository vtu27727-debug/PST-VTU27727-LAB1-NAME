public class Main {
    public static int digitSumOpt(int n, String opt) {
        int sum = 0;
        for (n = Math.abs(n); n > 0; n /= 10) {
            int d = n % 10;
            if ((opt.equalsIgnoreCase("EVEN") && d % 2 == 0) || 
                (opt.equalsIgnoreCase("ODD")  && d % 2 != 0)) {
                sum += d;
            }
        }
        return sum;
    }

    public static void main(String[] args) {
        System.out.println("Even Sum: " + digitSumOpt(123456, "EVEN")); 
        System.out.println("Odd Sum:  " + digitSumOpt(123456, "ODD"));  
    }
}
OUTPUT:
Even Sum: 12
Odd Sum:  9


