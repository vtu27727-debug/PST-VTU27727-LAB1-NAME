import java.util.function.BiFunction;

public class Main {
    public static BiFunction<Integer, Integer, Integer> sumLastDigits = 
        (a, b) -> Math.abs(a % 10) + Math.abs(b % 10);
    public static int sumLastDigits(int a, int b) {
        return Math.abs(a % 10) + Math.abs(b % 10);
    }

    public static void main(String[] args) {
        
        System.out.println("Sum: " + sumLastDigits.apply(26, 14)); 
        
}

OUTPUT:
SUM:10
